<UserControl x:Class="NotesDeskClient.Win.Controls.DayCalendarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="8" Padding="8" Background="#08FFFFFF">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="‹" Click="PrevMonth_Click" Width="24" Background="Transparent" BorderThickness="0"/>
                <TextBlock x:Name="MonthLabel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="›" Click="NextMonth_Click" Width="24" Background="Transparent" BorderThickness="0"/>
                <Button Grid.Column="3" Content="今天" Click="Today_Click" FontSize="11" Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="Orange" Cursor="Hand"/>
                <Button x:Name="ClearButton" Grid.Column="4" Content="清除" Click="Clear_Click" FontSize="11" Margin="4,0,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#888" Cursor="Hand" Visibility="Collapsed"/>
            </Grid>
            <UniformGrid Columns="7" Margin="0,0,0,2">
                <TextBlock Text="一" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="二" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="三" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="四" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="五" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="六" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock Text="日" FontSize="9" Foreground="#888" HorizontalAlignment="Center"/>
            </UniformGrid>
            <UniformGrid x:Name="DaysGrid" Columns="7"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse Width="5" Height="5" Fill="#FFCC00" Margin="0,0,3,0" VerticalAlignment="Center"/>
                <TextBlock Text="新建" FontSize="9" Foreground="#888" Margin="0,0,8,0"/>
                <Ellipse Width="5" Height="5" Fill="Red" Margin="0,0,3,0" VerticalAlignment="Center"/>
                <TextBlock Text="未完成" FontSize="9" Foreground="#888" Margin="0,0,8,0"/>
                <Ellipse Width="5" Height="5" Fill="LimeGreen" Margin="0,0,3,0" VerticalAlignment="Center"/>
                <TextBlock Text="已完成" FontSize="9" Foreground="#888"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
