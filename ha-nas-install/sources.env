# 安装前只改这个文件。密码不要写在这里。

# Home Assistant 版本。不要写 latest，也不要写不存在的版本号。
HA_VERSION=2026.9.4

# 镜像引用。三选一，优先级：HA_IMAGE_TAR > HA_IMAGE > 失败退出。
# 1) 本机已下载好的 docker save 包（推荐，NAS 上不用再拉 GHCR）
HA_IMAGE_TAR=assets/home-assistant-image.tar
# 2) 没有本地 tar 时，NAS 直接拉取这个地址。
#    不需要在 DSM / daemon.json 里配置 registry-mirrors。
#    docker 看到镜像名里的 ghcr.1ms.run，就会向该主机拉取。
HA_IMAGE=ghcr.1ms.run/home-assistant/home-assistant:2026.9.4

# 拉取镜像时核对此摘要。docker load 的 tar 往往没有 RepoDigests，此时只提示。
EXPECTED_IMAGE_DIGEST=sha256:3e6710a7ab2a61311d9d899b719f6c3657791c63e8f4942cec4ebc42401d6b76

# HACS。没有本地 zip 时下载 GitHub 最新发布包。
# 下载失败时，脚本会提示关注公众号并发送关键词获取百度云链接。
HACS_VERSION=latest
HACS_ZIP=assets/hacs.zip
HACS_URL=https://github.com/hacs/integration/releases/latest/download/hacs.zip
HACS_WECHAT_ACCOUNT=智能家居报告
HACS_WECHAT_KEYWORD=HACS

# 可选校验。留空则跳过。用 shasum -a 256 文件名 生成。
HACS_SHA256=
IMAGE_TAR_SHA256=

# 第一次安装的默认值。运行时会询问端口，直接回车就用这里的值。
# 8123 已被占用时，在提示符里另输入一个端口。
# 反向代理留空。需要时在提示符里输入，且不能和 HTTP 端口相同。
INSTALL_DIR=/volume1/docker/homeassistant
TZ=Asia/Shanghai
CONTAINER_NAME=homeassistant
HOST_PORT=8123
REVERSE_PROXY_HTTPS_PORT=

# Mosquitto。脚本会先检查本机是否已有同名容器或 1883 端口。
# 已有则复用。没有则在运行时询问，不会默认安装。
# 镜像在国内可能不好拉取。可以 docker save 后放到 tar，或改 MOSQUITTO_IMAGE。
MOSQUITTO_DIR=/volume1/docker/mosquitto
MOSQUITTO_CONTAINER=mosquitto
MOSQUITTO_PORT=1883
MOSQUITTO_IMAGE=docker.1ms.run/eclipse-mosquitto:2
MOSQUITTO_IMAGE_TAR=assets/mosquitto-image.tar
